# webmachine.toml
#
# Every knob this server reads from a file is here, with what it does
# and what it does without you. Nothing in this file changes anything
# until you change a line.

[server]
# The pictures on the error pages: a zip, one <status>.jpg per status.
# rake install puts it under PREFIX/share/mruby-webmachine and writes its
# path here. Without it the pages render without pictures.
# error_assets = "/usr/local/share/mruby-webmachine/error-assets.zip"

# How long a connection waits, in whole seconds. The names are those of
# the nginx directives that set the same times. Without a line the
# value in the comment holds.
# The whole head of a request, counted from its first byte:
# client_header_timeout = 60
# Between two reads of a request body:
# client_body_timeout = 60
# For one send to complete; a client that does not read is closed:
# send_timeout = 60
# For the next request on a persistent connection:
# keepalive_timeout = 75
# After the server closes its side, how long it still reads and drops
# what the client sends; at most 30:
# lingering_time = 5

[log]
# The key of the error fingerprint: 64 hex digits, 32 bytes. Every error
# page and every line of the error log carries a fingerprint, BLAKE2b
# with this key over the build, the request and the backtrace, so one
# failure has one fingerprint and a grep finds every time it happened.
# Keep the key, and a fingerprint from yesterday still names the same
# failure. Without it the server makes a new key at every start.
#   openssl rand -hex 32
# fingerprint_key = "..."
