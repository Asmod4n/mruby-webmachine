+# ==========================================================================
+# An emitted value cannot be swapped out afterwards
+# ==========================================================================
+
+# A value goes into the answer as itself, and the answer is put together
+# when the walk is over. So a to_s that runs later in the same render must
+# not be able to reach back and replace what an earlier tag already
+# handed over - least of all through an escaped tag, which had decided
+# there was nothing in it to escape.
+class Mustache_SwapOut
+  def initialize(target) = @target = target
+  def to_s
+    @target.replace("<script>alert(1)</script>")
+    ""
+  end
+end
+
+assert('an emitted value cannot be replaced by a later to_s') do
+  live = "safe"
+  out = Mustache::Template.new("{{a}}{{b}}")
+                          .render({ "a" => live, "b" => Mustache_SwapOut.new(live) })
+  assert_equal "safe", out
+end
+
+assert('the same holds for an unescaped tag') do
+  live = "safe"
+  out = Mustache::Template.new("{{{a}}}{{b}}")
+                          .render({ "a" => live, "b" => Mustache_SwapOut.new(live) })
+  assert_equal "safe", out
+end
+
+assert('a value is not left frozen by a render') do
+  live = "plain"
+  assert_equal "plain", Mustache::Template.new("{{a}}").render({ "a" => live })
+  assert_false live.frozen?
+end
+
+# ==========================================================================
+# The buffer a template renders into
+# ==========================================================================
+
+assert('a template says how much room it wants, and gives it back') do
+  t = Mustache::Template.compile("{{a}}")
+  assert_true t.capacity < 64             # nothing on the heap until it is needed
+
+  t.allocate(4096)
+  assert_true t.capacity >= 4096
+
+  t.render({ "a" => "x" * 100_000 })
+  assert_true t.capacity >= 100_000       # it grew, and stays grown
+
+  t.allocate(0)
+  assert_true t.capacity < 64             # given back, nothing on the heap
+  assert_equal "ok", t.render({ "a" => "ok" })
+
+  assert_raise(ArgumentError) { t.allocate(-1) }
+end
+
+class Mustache_AllocateWhileRendering
+  def initialize(t) = @t = t
+  def to_s
+    @t.allocate(0)
+    "not refused"
+  end
+end
+
+assert('a template refuses to move its buffer while it renders') do
+  t = Mustache::Template.compile("<{{b}}>")
+  assert_raise(Mustache::RenderError) do
+    t.render({ "b" => Mustache_AllocateWhileRendering.new(t) })
+  end
+end
