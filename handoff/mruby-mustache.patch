+assert('a template stops at the lid rather than growing without end') do
+  t = Mustache::Template.compile("{{#rows}}{{x}}{{/rows}}")
+  assert_equal 0, t.max_capacity            # no lid by default
+  assert_equal 1024, t.set_max_capacity(1024)
+  assert_equal 1024, t.max_capacity
+
+  rows = (1..100).map { { "x" => "y" * 100 } }
+  assert_raise(Mustache::RenderError) { t.render({ "rows" => rows }) }
+
+  t.set_max_capacity(0)
+  assert_equal 10_000, t.render({ "rows" => rows }).bytesize
+
+  assert_raise(ArgumentError) { t.set_max_capacity(-1) }
+end
